[Unit]
Description=Nightly XSTO 1-minute backfill enqueue
Documentation=file:%h/ibkr-trader/docs/xsto-minute-backfill.md

[Timer]
# 22:30 Europe/Stockholm: after the 17:30 close and after IBKR has settled the
# session, and aligned with the q-data daily cycle (Q_DATA_DAILY_TIME=22:30).
OnCalendar=*-*-* 22:30:00
Persistent=true
# The whole market lands at once; a small jitter avoids starting in lockstep
# with the q-data run on another host.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
