[Unit]
Description=Enqueue the previous XSTO session for 1-minute backfill
Documentation=file:%h/ibkr-trader/docs/xsto-minute-backfill.md
# Only useful if the API is up: the worker that drains the queue lives there.
After=ibkr-trader-api.service
Wants=ibkr-trader-api.service

[Service]
Type=oneshot
WorkingDirectory=%h/ibkr-trader
Environment=PYTHONPATH=src
# Enqueue only. This opens no broker connection and writes nothing to q-data;
# it appends to the durable queue that the trader's backfill worker drains
# under the pacing governor, on the historical client id.
#
# --granularity day is deliberate here: the nightly job extends the dataset by
# one session, so a monthly request would re-fetch weeks already held. Monthly
# is for the initial history fill, not for keeping current.
ExecStart=%h/ibkr-trader/.venv/bin/python scripts/enqueue_previous_session_backfill.py

# A failed enqueue is not urgent: the next night picks up both sessions, because
# the generator asks for whatever is missing rather than assuming yesterday.
Restart=no
