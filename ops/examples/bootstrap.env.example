# Example protected bootstrap environment for the trader application.
#
# Install as /etc/ibkr-trader/bootstrap.env, owned by root and NOT world-readable:
#
#   SERVICE_GROUP=<group the trader service user belongs to>
#   sudo install -d -m 0750 -o root -g "$SERVICE_GROUP" /etc/ibkr-trader
#   sudo install -m 0640 -o root -g "$SERVICE_GROUP" \
#       ops/examples/bootstrap.env.example /etc/ibkr-trader/bootstrap.env
#   sudo -e /etc/ibkr-trader/bootstrap.env
#
# The group matters on BOTH the directory and the file: the trader runs as an
# unprivileged user systemd service and must be able to traverse /etc/ibkr-trader.
# A root:root 0750 directory is not traversable and startup fails with a
# permission error. Verify with:
#
#   sudo -u <service user> head -c1 /etc/ibkr-trader/bootstrap.env >/dev/null && echo readable
#
# With APP_ENV=production this file is REQUIRED and AUTHORITATIVE: it overrides
# ambient environment variables, the checkout-local .env is ignored entirely, and
# startup fails if any required key below is missing or empty.
#
# Secrets belong here. Non-secret operational settings belong in the PostgreSQL
# settings registry instead, so changing one does not require editing this file.
#
# See docs/bootstrap-configuration.md.

# --- Required -------------------------------------------------------------

# No production default exists: the development default is a local throwaway
# database, and using it live would write the ledger where nobody reads it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ibkr_trader

# The live IB Gateway endpoint.
#   IB Gateway:  live 4001   paper 4002
#   TWS:         live 7496   paper 7497
# The paper ports (7497, 4002) are REFUSED in production. Note .env.example
# ships 4002, so do not copy that value across without checking.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001

# At least one of these must be set.
IBKR_ACCOUNT_IDS=U1234567
# IBKR_ACCOUNT_ID=U1234567

# Shared dataset catalog. REQUIRED in production: it has no default, and in
# production the checkout .env is not read, so without it startup dies with a
# QDataContractError that reads like a data problem rather than a config one.
# Resolved only through the catalog; there is no path fallback, because
# inferring authority from a path is how a stale artefact gets read as current.
Q_DATA_CATALOG_PATH=/mnt/q-data/catalog.json

# --- Optional -------------------------------------------------------------

# Canonical IBKR client IDs are role-based; override only with good reason.
# 0 = runtime, 7 = diagnostics/probes, 8 = historical/backfill, 9 = streaming
# IBKR_CLIENT_ID=0
# IBKR_DIAGNOSTIC_CLIENT_ID=7
# IBKR_HISTORICAL_CLIENT_ID=8
# IBKR_STREAMING_CLIENT_ID=9

# API_HOST=127.0.0.1
# API_PORT=8000
# API_REQUIRE_LOOPBACK_ONLY=true
